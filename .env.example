# Credenciais do portal. Nunca versione o arquivo .env real.
LOGIN=
SENHA=

# Modo visível para acompanhar a automação na tela.
HEADLESS=false

# WhatsApp Web: informe apenas dígitos, com DDI (Brasil: 55).
# WHATSAPP_SENDER é o número que você conectará por QR Code.
WHATSAPP_SENDER=5511999999999
WHATSAPP_RECIPIENTS=["5511999999999"]
# false abre o WhatsApp Web no Chromium e mostra o QR Code visualmente.
WHATSAPP_HEADLESS=false
# Quanto esperar (ms) pela confirmação de recebimento do servidor por mensagem.
WHATSAPP_ACK_TIMEOUT_MS=30000
# Margem extra (ms) após enviar, antes de encerrar o cliente/Chromium.
WHATSAPP_SETTLE_MS=3000
